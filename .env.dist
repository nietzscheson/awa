# Awa — the real-time interview. Copy to `.env` (`task env` does it for you) and
# fill in the two keys. Everything commented out is a default you can ignore.
#
# One file for both halves of the repo: `taskfile.yaml` loads it for the API, and
# the Next.js app reads this same file through `src/lib/rootEnv.ts`.
#
# Careful with direnv/Nix: this file is exported into your shell, and a variable
# already in the environment beats the file. After editing, `direnv reload`.

# ── Interview agent — Google ADK + Gemini Live (core/) ──────────────────────
# https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=

# ADK session storage. The default matches compose.yaml (`task docker:up`).
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres

# Must be a *-live model: the interview is bidirectional audio.
# GEMINI_STREAMING_MODEL_NAME=gemini-3.1-flash-live-preview
# Prebuilt Live voice; the full list is in core/src/enums.py.
# GEMINI_VOICE_NAME=Aoede
# Default interview language. The setup screen picks the real one per session,
# so this only applies to a session that doesn't choose.
# GEMINI_LANGUAGE_CODE=en-US
# Thinking level: MINIMAL | LOW | MEDIUM | HIGH. The model emits no audio while
# it thinks, so every level above MINIMAL is silence the candidate waits through.
# GEMINI_THINKING_LEVEL=MINIMAL

# ── Interview client — Next.js (web/packages/app, :5173) ────────────────────
# Where the client proxies ``/adk/*`` — the port ``task api`` listens on.
# ADK_API_ORIGIN=http://localhost:8000
# Set to an absolute origin to bypass the proxy and talk to ADK directly. The
# ADK server then needs --allow_origins.
# NEXT_PUBLIC_ADK_BASE=
# ADK `app_name` — which agent the client launches. Default `streaming`; set it
# to try another folder under `core/src/agents/` (it must export `root_agent`,
# or the session POST 404s). Inlined at build time: restart `next` after a change.
# NEXT_PUBLIC_ADK_APP_NAME=streaming
# Trace every live event in the browser console, with the per-turn latency (first
# word / first audio / turn complete), tool calls and thought summaries. On by
# default under ``next dev``; set ``0`` to silence it.
NEXT_PUBLIC_LIVE_DEBUG=

# ── Talking head — LiveAvatar, LITE mode ───────────────────────────────────
# https://app.liveavatar.com/developers. Optional: without it the interview runs
# voice-only. Never reaches the browser — it mints a per-session token instead.
LIVEAVATAR_API_KEY=
# Sandbox = free, pins the "Wayne" avatar, self-closes after ~1 min.
LIVEAVATAR_SANDBOX=true
# A real avatar (consumes credits per minute). Needs SANDBOX=false; ignored in
# sandbox mode. Ids: GET https://api.liveavatar.com/v1/avatars/public
# LIVEAVATAR_AVATAR_ID=ab0765ad-69de-41fb-9f8a-bd01c3c52d6f
# Optional: video quality (very_high|high|medium|low), session cap in seconds.
# LIVEAVATAR_VIDEO_QUALITY=high
# LIVEAVATAR_MAX_SESSION_DURATION=600
# LIVEAVATAR_API_URL=https://api.liveavatar.com
